generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
}

model User {
  studentNo        String   @id
  username         String?  @unique // login name for demo accounts; real students use their student number via SSO
  passwordHash     String? // demo accounts only; SSO users never store passwords
  authSource       String // "demo" | "sso"
  nameZh           String
  nameEn           String
  major            String // e.g. "CSE"
  year             Int // 1-4
  creditsCompleted Float @default(0)
  createdAt        DateTime @default(now())

  sessions        Session[]
  plans           Plan[]
  candidates      Candidate[]
  registrations   Registration[]
  enrollments     Enrollment[]
  completedCourses CompletedCourse[]
  notifications   Notification[]
}

model Session {
  id        String   @id // 64-char random hex
  userId    String
  user      User     @relation(fields: [userId], references: [studentNo], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Term {
  id            String   @id // "2026-Fall"
  labelZh       String
  labelEn       String
  regOpenAt     DateTime
  regCloseAt    DateTime
  addDropCloseAt DateTime
  creditLimit   Float    @default(18)

  courses       Course[]
  plans         Plan[]
  registrations Registration[]
  enrollments   Enrollment[]
}

model Course {
  id             String @id // "CSC4130"
  termId         String
  term           Term   @relation(fields: [termId], references: [id])
  titleZh        String
  titleEn        String
  credits        Float
  category       String // major_required | major_elective | general_education | free_elective
  instructorZh   String
  instructorEn   String
  rating         Float?
  reviews        Int?
  demand         String? // 高/中/低
  workload       String? // 较高/中等/较低
  descriptionZh  String  @default("")
  descriptionEn  String  @default("")
  grading        String  @default("Graded")
  // structured eligibility (JSON-encoded arrays where lists)
  minYear        Int?
  majorsAllowed  String? // JSON array of major codes, null = all
  prereqCourseIds String? // JSON array of course ids
  excludedCourseIds String? // JSON array: having completed any of these blocks enrollment
  targetZh       String?
  targetEn       String?
  tone           String  @default("teal") // visual accent, existing UI uses it

  sections    Section[]
  candidates  Candidate[]
  notifications Notification[]
}

model Section {
  id               String @id // "CSC4130-L01"
  courseId         String
  course           Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind             String // LEC | TUT
  sectionCode      String // "L01" | "T02"
  classNbr         Int // 4-digit like real SIS
  capacity         Int
  enrolledCount    Int    @default(0)
  reservedQuota    Int    @default(0)
  reservedForZh    String?
  reservedForEn    String?
  waitlistCapacity Int    @default(0)
  waitlistCount    Int    @default(0)

  meetings        Meeting[]
  planItems       PlanItem[]
  tutorialOfItems PlanItem[]  @relation("TutorialSection")
  registrationItems RegistrationItem[]
  enrollments     Enrollment[]

  @@unique([courseId, sectionCode])
}

model Meeting {
  id        String @id @default(cuid())
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Mon..4=Fri
  startMin  Int // minutes since midnight
  endMin    Int
  room      String
  dateStart String // "2026-09-01"
  dateEnd   String

  @@index([sectionId])
}

model Plan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [studentNo], onDelete: Cascade)
  name      String
  termId    String
  term      Term     @relation(fields: [termId], references: [id])
  createdAt DateTime @default(now())

  items PlanItem[]

  @@unique([userId, name])
}

model PlanItem {
  id                String  @id @default(cuid())
  planId            String
  plan              Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  sectionId         String
  section           Section @relation(fields: [sectionId], references: [id])
  tutorialSectionId String?
  tutorialSection   Section? @relation("TutorialSection", fields: [tutorialSectionId], references: [id])
  role              String  @default("primary") // primary | backup
  backupOfItemId    String?
  priority          Int     @default(0) // ordering for backups / priority list
  addedAt           DateTime @default(now())

  @@index([planId])
}

model Candidate {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [studentNo], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())
  dismissed Boolean @default(false)

  @@unique([userId, courseId])
}

model Registration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [studentNo], onDelete: Cascade)
  termId      String
  term        Term     @relation(fields: [termId], references: [id])
  planId      String?
  submittedAt DateTime @default(now())

  items RegistrationItem[]
}

model RegistrationItem {
  id               String  @id @default(cuid())
  registrationId   String
  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  sectionId        String
  section          Section @relation(fields: [sectionId], references: [id])
  status           String // registered | failed | waitlist | dropped
  failReason       String? // prereq | year | major | excluded | full | conflict | credit_limit | time_window | tutorial_full | tutorial_conflict
  failDetailZh     String?
  failDetailEn     String?
  waitlistPosition Int?

  @@index([registrationId])
}

model Enrollment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [studentNo], onDelete: Cascade)
  sectionId String
  section   Section   @relation(fields: [sectionId], references: [id])
  termId    String
  term      Term      @relation(fields: [termId], references: [id])
  status    String    @default("enrolled") // enrolled | dropped
  source    String    @default("plan") // plan | manual | swap
  createdAt DateTime  @default(now())
  droppedAt DateTime?

  @@unique([userId, sectionId, termId])
  @@index([userId, termId, status])
}

model CompletedCourse {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [studentNo], onDelete: Cascade)
  courseCode String
  credits    Float
  grade      String
  term       String // "2024-25 Term 1"

  @@unique([userId, courseCode])
}

model DegreeRequirement {
  id             String @id @default(cuid())
  major          String
  category       String // major_required | major_elective | general_education | free_elective | total
  requiredCredits Float
  labelZh        String
  labelEn        String

  @@unique([major, category])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String? // null = broadcast to all
  user      User?    @relation(fields: [userId], references: [studentNo], onDelete: Cascade)
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  kind      String // course_update | requirement_change | system
  bodyZh    String
  bodyEn    String
  createdAt DateTime @default(now())
  readAt    DateTime?

  @@index([userId])
}
